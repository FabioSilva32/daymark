# ==============================================================================
# DAYMARK ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Required for remote cloud persistence and auth. When omitted, Daymark operates in
# local-first offline resilient mode with IndexedDB/LocalStorage storage adapter.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Weather Provider Configuration (Open-Meteo)
# Open-Meteo does not require an API key for standard non-commercial usage.
# If an enterprise key is used:
OPEN_METEO_API_KEY=

# AI Assistant Provider (Optional)
# Supports OpenAI, Anthropic, or any OpenAI-compatible API endpoint (e.g. Groq, Local Ollama, DeepSeek)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1

# Currency Exchange Rates API (Optional fallback to ExchangeRate-API or Open Exchange Rates)
EXCHANGE_RATE_API_KEY=
